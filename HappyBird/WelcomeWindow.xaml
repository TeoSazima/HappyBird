<Window x:Class="HappyBird.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HappyBird"
        mc:Ignorable="d"
        Title="HappyBird - Welcome" Height="450" Width="250"
        ResizeMode="NoResize">
    <Grid>
        <Image Name="flappyBird" Source="source/images/Bird/yellow/tile000.png" Height="50" Width="50" RenderTransformOrigin="0.377,-0.208" Margin="75,10,75,314"/>
        <TextBlock FontWeight="ExtraBold"  FontSize="30" HorizontalAlignment="Center" Margin="0,97,0,0" TextWrapping="Wrap" Text="HAPPY BIRD" VerticalAlignment="Top"/>
        <TextBlock FontWeight="ExtraBold"  FontSize="20" HorizontalAlignment="Center" Margin="0,141,0,0" TextWrapping="Wrap" Text="Sazima Mateo" VerticalAlignment="Top"/>
        <TextBlock FontWeight="ExtraBold"  FontSize="15" HorizontalAlignment="Center" Margin="0,163,0,0" TextWrapping="Wrap" Text="I3.C" VerticalAlignment="Top"/>
        <Button Content="PLAY" FontSize="15" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" Width="102" Click="Button_Click"/>
    </Grid>
</Window>
