<Window x:Class="HappyBird.ScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HappyBird"
        mc:Ignorable="d"
        Title="HappyBird - Leaderboard" Width="300" Height="500" Closing="ScoreWindow_OnClosing"
        ResizeMode="NoResize"
        KeyDown="ScoreWindow_OnKeyDown"
        >
        
        
        <Grid>
                <ListBox Name="lstbox_Leaderboard" Height="370" FontWeight="ExtraBold" FontSize="15"/>
                <TextBlock Visibility="Visible" Text="LEADERBOARD" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="ExtraBold"/>       
                <Button Visibility="Visible" Name="btn_Submit" FontWeight="ExtraBold" Height="30" Width="50" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Content="SUBMIT" Click="Btn_Submit"/>
                <TextBox Name="txtbox_Nickname" FontSize="15" TextAlignment="Center" FontWeight="ExtraBold" Text="ENTER YOUR NICKNAME"  Height="30" Width="200" Margin="0,0,50,10" VerticalAlignment="Bottom" HorizontalAlignment="Center" GotFocus="Txtbox_Nickname_OnGotFocus" />

                
                
        </Grid>
</Window>


